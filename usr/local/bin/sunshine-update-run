#!/usr/bin/env bash
# Safe, friendly full-system update. Runs as root (via pkexec).
set -u
[ -r /usr/local/lib/sunshine/ui.sh ] && . /usr/local/lib/sunshine/ui.sh || { B=; Y=; G=; R=; N=; say() { echo "* $*"; }; ok() { echo "+ $*"; }; bad() { echo "x $*"; }; cozy_done() { :; }; sun_success_anim() { :; }; }
finish() { echo; read -rp "Press Enter to close this window." _; exit "${1:-0}"; }

[ "$(id -u)" -eq 0 ] || exec pkexec "$0" "$@"
REAL_USER=${PKEXEC_UID:+$(getent passwd "$PKEXEC_UID" | cut -d: -f1)}

say "Sunshine OS update"
# the newest Sunshine tools first (signed release from the tools repository): a repair tool fixed yesterday works today, without a new ISO
if [ -x /usr/local/bin/sunshine-toolsync ]; then say "Sunshine tools"; /usr/local/bin/sunshine-toolsync update || true; fi
/usr/local/bin/sunshine-repo ensure --quiet   # the [sunshine] repository must be in pacman.conf (it can be lost with a merged pacman.conf)
if [ -e /var/lib/pacman/db.lck ]; then
  if pgrep -x pacman >/dev/null; then bad "Another update or install is running. Close it and try again."; finish 1; fi
  bad "A stale lock file was found (no package manager is running); removing it."
  rm -f /var/lib/pacman/db.lck
fi
ping -c1 -W3 archlinux.org >/dev/null 2>&1 || { bad "No internet connection. Connect to Wi-Fi or a cable and try again."; finish 1; }

say "Latest Arch Linux news (read if something looks important)"
curl -fsS --max-time 8 https://archlinux.org/feeds/news/ 2>/dev/null \
  | grep -o '<title>[^<]*</title>' | sed -n '2,4p' | sed 's/<[^>]*>//g;s/^/  • /' || true

say "Checking for updates"
if command -v checkupdates >/dev/null; then
  list=$(sudo -u "${REAL_USER:-nobody}" checkupdates 2>/dev/null || true)
  n=$(printf '%s' "$list" | grep -c . || true)
  [ "$n" -gt 0 ] && { echo "$n package update(s) available."; } || echo "$(loc "No system package updates right now.")"
fi

if [ "$(findmnt -no FSTYPE /)" = btrfs ] && [ -e /etc/snapper/configs/root ]; then
  ok "Restore points are made automatically before and after the update (go back from the boot menu if anything breaks)"
fi
/usr/local/bin/sunshine-identity check --quiet || { /usr/local/bin/sunshine-identity apply --quiet && ok "System identity restored"; }

say "Refreshing the mirror list"
refresh_mirrors() {   # rate-mirrors ranks the mirrors by speed; the old list is kept if anything goes wrong
  command -v rate-mirrors >/dev/null || { bad "rate-mirrors is not installed yet (it is installed after this update and used next time): keeping the current list"; return 0; }
  local target new
  for target in arch:/etc/pacman.d/mirrorlist chaotic-aur:/etc/pacman.d/chaotic-mirrorlist; do
    [ -f "${target#*:}" ] || continue
    new=$(mktemp); cp -n "${target#*:}" "${target#*:}.sunshine-backup" 2>/dev/null
    if rate-mirrors --allow-root --protocol https --save="$new" "${target%%:*}" >/dev/null 2>&1 && grep -q '^Server' "$new"; then
      install -m644 "$new" "${target#*:}" && ok "${target%%:*} mirrors ranked"
    else bad "could not rank the ${target%%:*} mirrors: keeping the current list"; fi
    rm -f "$new"
  done
}
refresh_mirrors

say "Updating system packages"
if pacman -Syu; then ok "System packages are up to date"
  # a new sunshine-base may bring new repositories (Chaotic-AUR): add them now and update once more
  rm -f /run/sunshine-repo-changed; /usr/local/bin/sunshine-repo ensure --quiet; [ -e /run/sunshine-repo-changed ] && { say "New repository added: updating again"; pacman -Syu --noconfirm; }
  command -v rate-mirrors >/dev/null || { pacman -S --noconfirm --needed rate-mirrors >/dev/null 2>&1 && refresh_mirrors; }
else bad "The system update did not finish. Nothing is broken by stopping; you can run the update again."; finish 1; fi

# Sirius (declarative): upgrade the Nix profiles, then make the system match /etc/sunshine/declarative.toml
if [ -x /usr/local/bin/sunshine-declare ]; then
  say "Declarative setup (Sirius)"
  command -v nix >/dev/null && { nix profile upgrade --all --profile /nix/var/nix/profiles/sunshine >/dev/null 2>&1; nix-channel --update >/dev/null 2>&1; } && ok "Nix packages are up to date"
  /usr/local/bin/sunshine-declare apply
fi

if command -v flatpak >/dev/null && flatpak remotes 2>/dev/null | grep -q .; then
  say "Updating Flatpak apps"; flatpak update -y --noninteractive || true
fi
aurh=$(command -v paru || command -v yay || true)
if [ -n "$aurh" ] && [ -n "${REAL_USER:-}" ]; then
  say "Updating AUR (community) packages"; sudo -u "$REAL_USER" "$aurh" -Sua --noconfirm --needed || true
fi

say "Tidying up"
command -v paccache >/dev/null && paccache -rqk2 && ok "Old package cache cleaned"
orph=$(pacman -Qdtq 2>/dev/null || true)
[ -n "$orph" ] && echo "Unused packages (you can remove later): $(echo $orph | wc -w)"
pn=$(find /etc -name '*.pacnew' 2>/dev/null | head -5)
[ -n "$pn" ] && { echo "$(loc "Config updates waiting for review (*.pacnew):")"; echo "$pn"; }
if [ -d /usr/lib/modules ] && ! [ -d "/usr/lib/modules/$(uname -r)" ]; then
  printf '\n%sThe kernel was updated. Please restart your computer when convenient.%s\n' "$Y" "$N"
fi
say "Apps you chose"
/usr/local/bin/sunshine-apps apply 2>&1 | tail -5        # AUR packages, setup and web apps that were waiting for the internet
/usr/local/bin/sunshine-apps first-update 2>&1 | tail -5 # LibreOffice, Zen ...: offered on the very first update (once)
say "Health check"
/usr/local/bin/sunshine-doctor --fix --quiet || true
[ -n "${REAL_USER:-}" ] && { sudo -u "$REAL_USER" /usr/local/bin/sunshine-update-check seen; sudo -u "$REAL_USER" /usr/local/bin/sunshine-update-check --quiet; } >/dev/null 2>&1
ok "$(t all_done "All done")"
[ -x /usr/local/bin/sunshine-diagnose ] && [ -n "${REAL_USER:-}" ] && sudo -u "$REAL_USER" /usr/local/bin/sunshine-diagnose --after-update >/dev/null 2>&1 &
[ "$(sun_conf visuals_on_update off 2>/dev/null)" = on ] && [ -n "${REAL_USER:-}" ] && sudo -u "$REAL_USER" /usr/local/bin/sunshine-restore-visuals >/dev/null 2>&1
sun_success_anim; cozy_done
finish 0
