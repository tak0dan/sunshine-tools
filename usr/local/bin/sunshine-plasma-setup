#!/bin/bash
# First Plasma login: Sunshine wallpaper (flower), panel launchers (Store instead of Discover). Runs once per user.
M="${XDG_STATE_HOME:-$HOME/.local/state}/sunshine/plasma-setup.done"
[ "${1:-}" = --reapply ] && rm -f "$M"
[ -e "$M" ] && exit 0
for i in $(seq 1 40); do pgrep -x plasmashell >/dev/null && break; sleep 1; done
sleep 4
W="$HOME/Pictures/wallpapers/SunshineOS_Flower_Bloom.png"
[ -f "$W" ] || W=/usr/share/sunshine/login.png
APPLETS="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
for i in $(seq 1 30); do   # Plasma may not be ready to take the wallpaper yet: retry until it shows up in the config
  command -v plasma-apply-wallpaperimage >/dev/null && plasma-apply-wallpaperimage "$W" >/dev/null 2>&1
  grep -q "$(basename "$W")" "$APPLETS" 2>/dev/null && break; sleep 3
done
command -v plasma-apply-colorscheme >/dev/null && plasma-apply-colorscheme SunshineDark
# Darkly widget style (the Dolphin view and sidebar transparency from ~/.config/darklyrc need it); only when it is installed
[ -e /usr/lib/qt6/plugins/styles/libkvantum.so ] && kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle kvantum
# Sunshine icons (Fluent, orange variant) when the package is installed
[ -d /usr/share/icons/Sunshine-orange-dark ] && { /usr/lib/plasma-changeicons Sunshine-orange-dark >/dev/null 2>&1 || kwriteconfig6 --file kdeglobals --group Icons --key Theme Sunshine-orange-dark; }
# Sunshine theme: Plasma theme, window decoration with the buttons on the right
command -v plasma-apply-desktoptheme >/dev/null && plasma-apply-desktoptheme Sunshine
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme __aurorae__svg__Sunshine
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft ""
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight IAX
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
# Virtual machines (no 3D): turn off the heavy effects so Plasma stays responsive
if systemd-detect-virt -q 2>/dev/null; then
  kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
  kwriteconfig6 --file kwinrc --group Plugins --key wobblywindowsEnabled false
  kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled false
  kwriteconfig6 --file kwinrc --group Plugins --key slidingpopupsEnabled false
  kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
fi
Q=$(command -v qdbus6 || command -v qdbus)
SM=false; [ -d /usr/share/plasma/plasmoids/com.sunshineos.startmenu ] && SM=true
# Windows 11 style taskbar: 48 px, full width, menu + app icons centred between two spacers, tray and clock on the right
[ -n "$Q" ] && "$Q" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'var L=["applications:sunshine-store.desktop","applications:org.kde.dolphin.desktop","applications:firefox.desktop","applications:org.kde.konsole.desktop","applications:org.kde.kate.desktop","applications:sunshine-welcome.desktop"];
var startmenu='"$SM"'; var updates=startmenu;
var p=panels()[0];
for (var id of p.widgetIds) p.widgetById(id).remove();
p.height=48; p.floating=false; p.lengthMode="fill";
p.addWidget("org.kde.plasma.panelspacer");
var k=p.addWidget(startmenu?"com.sunshineos.startmenu":"org.kde.plasma.kickoff"); k.globalShortcut="Meta"; k.currentConfigGroup=["General"]; k.writeConfig("icon","sunshine-menu"); k.writeConfig("favoritesDisplay",0); k.writeConfig("applicationsDisplay",0); k.writeConfig("favorites",L.concat(["applications:sunshine-toolbox.desktop","applications:systemsettings.desktop"]));
var t=p.addWidget("org.kde.plasma.icontasks"); t.currentConfigGroup=["General"]; t.writeConfig("launchers",L);
p.addWidget("org.kde.plasma.panelspacer");
p.addWidget(updates?"com.sunshineos.updates":"org.kde.plasma.marginsseparator");
p.addWidget("org.kde.plasma.systemtray");
p.addWidget("org.kde.plasma.digitalclock");
p.addWidget("org.kde.plasma.showdesktop");
' >/dev/null 2>&1
[ -x /usr/local/bin/sunshine-topbar ] && /usr/local/bin/sunshine-topbar
mkdir -p "$(dirname "$M")"; : > "$M"
