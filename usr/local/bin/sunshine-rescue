#!/usr/bin/env bash
# Sunshine OS rescue: repair an installed Linux system from the live session (like Garuda's boot repair, but for the whole system).
# It finds installed systems on all disks (ext4, btrfs with @ subvolumes, XFS, f2fs; LUKS is opened when you give the passphrase), mounts them the
# way they are mounted when running (fstab, /boot, the EFI partition), and works inside them with arch-chroot.
#
#   sunshine-rescue                   menu
#   sunshine-rescue list              installed systems found on this computer
#   sunshine-rescue repair [DEV]      repair the system: file system, package database, kernel, initramfs, boot loader, fstab check, sunshine-doctor --fix
#   sunshine-rescue bootloader [DEV]  only reinstall GRUB and rebuild its menu
#   sunshine-rescue initramfs [DEV]   only rebuild the initramfs for every installed kernel
#   sunshine-rescue passwd USER [DEV] set a new password for a user of the installed system
#   sunshine-rescue fsck [DEV]        check the file system (while it is not mounted)
#   sunshine-rescue chroot [DEV]      a shell inside the installed system
#   sunshine-rescue run [DEV] -- CMD  run a command inside it
#   sunshine-rescue mount [DEV]       mount it under /mnt/sunshine-rescue and leave it mounted
#   sunshine-rescue umount            unmount everything this tool mounted
# DEV is the root partition (for example /dev/sda2); without it the only installed system is used, or you are asked.
# Environment for scripts: SUNSHINE_LUKS_PASS (passphrase of the encrypted disk), SUNSHINE_NEW_PASS (for passwd), SUNSHINE_RESCUE_FSCK=0 (skip the check).
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
# shellcheck disable=SC2034 # fallback colour names mirror ui.sh even when one is unused here
[ -r /usr/local/lib/sunshine/ui.sh ] && . /usr/local/lib/sunshine/ui.sh || { sec() { echo "* $*"; }; ok() { echo "+ $*"; }; bad() { echo "x $*"; }; loc() { printf '%s' "$*"; }; t() { printf '%s' "${2:-$1}"; }; Y=; G=; R=; B=; N=; }
M=${SUNSHINE_RESCUE_MNT:-/mnt/sunshine-rescue}
STATE=/run/sunshine-rescue; mkdir -p "$STATE"
LOG=/tmp/sunshine-rescue.log
LUKS_STATE=$STATE/luks          # mappings opened by this tool (scan runs in a subshell, so keep this on disk)
CLEANED=0                       # do_umount is idempotent (signal handler + normal cleanup)
die() { bad "$*"; exit 1; }
need() { command -v "$1" >/dev/null || die "$(loc "missing tool"): $1"; }
osname() { local p; p=$(sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$1" 2>/dev/null | head -1); printf '%s' "${p:-Linux}"; }

# ---------------------------------------------------------------- finding systems
# One line per installed system: DEVICE[:subvolume] <TAB> FSTYPE <TAB> PRETTY NAME
open_luks() {   # open every LUKS container (asks for the passphrase in a terminal, or uses SUNSHINE_LUKS_PASS)
  local d name opened
  for d in $(lsblk -rpno NAME,FSTYPE | awk '$2=="crypto_LUKS"{print $1}'); do
    name=sunshine-luks-$(basename "$d")
    opened=0
    if [ ! -e "/dev/mapper/$name" ]; then
      if [ -n "${SUNSHINE_LUKS_PASS:-}" ]; then printf %s "$SUNSHINE_LUKS_PASS" | cryptsetup open "$d" "$name" - 2>/dev/null || { bad "$d: $(loc "could not be opened (wrong passphrase?)")" >&2; continue; }; opened=1
      elif [ -t 0 ]; then echo "$d $(loc "is encrypted") ..." >&2; cryptsetup open "$d" "$name" </dev/tty >&2 || continue; opened=1
      else continue; fi
    fi
    [ "$opened" = 1 ] && printf '%s\n' "$name" >> "$LUKS_STATE"
    echo "/dev/mapper/$name"
  done
}
scan() {
  local tmp dev fs sub; tmp=$(mktemp -d)
  open_luks >/dev/null
  for dev in $(lsblk -rpno NAME,FSTYPE | awk '$2 ~ /^(ext4|ext3|btrfs|xfs|f2fs)$/{print $1}'); do
    fs=$(lsblk -rno FSTYPE "$dev" | head -1)
    case "$(findmnt -rno TARGET -S "$dev" 2>/dev/null | head -1)" in /run/archiso*|/) continue;; esac
    mount -o ro,noload "$dev" "$tmp" 2>/dev/null || mount -o ro "$dev" "$tmp" 2>/dev/null || continue
    if [ -f "$tmp/etc/os-release" ] && [ -f "$tmp/etc/fstab" ]; then
      printf '%s\t%s\t%s\n' "$dev" "$fs" "$(osname "$tmp/etc/os-release")"
    elif [ "$fs" = btrfs ]; then
      for sub in @ root rootfs; do
        if [ -f "$tmp/$sub/etc/os-release" ]; then
          printf '%s\t%s\t%s\n' "$dev:$sub" "$fs" "$(osname "$tmp/$sub/etc/os-release")"; break
        fi
      done
    fi
    umount "$tmp" 2>/dev/null
  done
  rmdir "$tmp" 2>/dev/null
}
pick() {   # the system to work on: named, the only one, or asked for
  local want=${1:-} list n i
  list=$(scan)
  [ -n "$list" ] || die "$(loc "No installed Linux system was found. If the disk is encrypted, run this in a terminal or set SUNSHINE_LUKS_PASS.")"
  if [ -n "$want" ]; then
    printf '%s\n' "$list" | awk -F'\t' -v w="$want" '$1==w || index($1,w":")==1 {print; exit}' | grep . && return 0
    die "$want: $(loc "is not an installed system")"
  fi
  n=$(printf '%s\n' "$list" | wc -l)
  [ "$n" = 1 ] && { printf '%s\n' "$list"; return 0; }
  [ -t 0 ] || die "$(loc "Several systems found; name one: sunshine-rescue repair /dev/...")"
  printf '%s\n' "$list" | nl -w2 -s'  ' >&2
  read -rp "$(loc "Which one? number: ")" i </dev/tty
  printf '%s\n' "$list" | sed -n "${i}p" | grep .
}

# ---------------------------------------------------------------- mounting
is_mounted() { mountpoint -q "$M"; }
do_umount() {
  [ "${CLEANED:-0}" = 1 ] && return 0
  CLEANED=1
  local m rc=0
  if is_mounted; then
    if ! umount -R "$M" 2>>"$LOG"; then
      if umount -Rl "$M" 2>>"$LOG"; then bad "$(loc "needed a lazy unmount of") $M ($(loc "check for processes still using it"))"; else bad "$(loc "could not unmount") $M"; fi
      rc=1
    fi
  fi
  rm -f "$STATE/system"
  if [ -f "$LUKS_STATE" ]; then
    while read -r m; do
      [ -n "$m" ] || continue
      [ -e "/dev/mapper/$m" ] || continue
      if findmnt -rno SOURCE 2>/dev/null | grep -Fq "/dev/mapper/$m"; then bad "$(loc "LUKS mapping is still mounted") $m"; rc=1; continue; fi
      cryptsetup close "$m" 2>>"$LOG" || { bad "$(loc "could not close LUKS mapping") $m"; rc=1; }
    done < "$LUKS_STATE"
    rm -f "$LUKS_STATE"
  fi
  return $rc
}
trap 'do_umount; exit 130' INT
trap 'do_umount; exit 143' TERM
trap 'do_umount; exit 129' HUP
do_mount() {     # do_mount "dev[:subvol]<TAB>fs<TAB>name"
  local line=$1 dev sub fs
  dev=$(printf '%s' "$line" | cut -f1); fs=$(printf '%s' "$line" | cut -f2); sub=
  case "$dev" in *:*) sub=${dev#*:}; dev=${dev%%:*};; esac
  CLEANED=0
  is_mounted && do_umount
  mkdir -p "$M"
  if [ "$fs" = btrfs ]; then mount -o "subvol=${sub:-@}" "$dev" "$M" 2>>"$LOG" || mount "$dev" "$M" 2>>"$LOG" || die "$(loc "could not mount") $dev"
  else mount "$dev" "$M" 2>>"$LOG" || die "$(loc "could not mount") $dev"; fi
  if [ ! -f "$M/etc/os-release" ] || [ ! -f "$M/etc/fstab" ]; then do_umount; die "$(loc "mounted") $dev $(loc "but it is not the selected system (no /etc/os-release or /etc/fstab)")"; fi
  # the other file systems of the installed system, as its own fstab says: /boot, the EFI partition, /home, /var ...
  while read -r src mp type opts; do
    case "$src" in UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*|/dev/*) ;; *) continue;; esac
    mkdir -p "$M$mp" || { fail "$(loc "cannot create mount point") $mp"; continue; }
    if ! mountpoint -q "$M$mp"; then
      if ! mount -t "$type" -o "$opts" "$src" "$M$mp" 2>>"$LOG" && ! mount "$src" "$M$mp" 2>>"$LOG"; then
        case "$opts" in *nofail*) ;; *) fail "$(loc "could not mount") $src $(loc "on") $mp";; esac
      fi
    fi
  done < <(awk '$1!~/^#/ && NF>=4 && $2!="/" && $2!="none" && $3!="swap" && $3!~/^(nfs|cifs|tmpfs|proc|sysfs|devpts)/ {print $1, $2, $3, $4}' "$M/etc/fstab")
  echo "$line" > "$STATE/system"
  ok "$(loc "mounted at") $M ($(printf '%s' "$line" | cut -f3))"
}
inchroot() { SUNSHINE_IN_RESCUE=1 arch-chroot "$M" "$@"; }

# ---------------------------------------------------------------- repairs (each prints what really happened)
fails=0
fail() { fails=$((fails+1)); bad "$*"; }
step_pacman() {
  sec "Package database"
  rm -f "$M/var/lib/pacman/db.lck"
  if inchroot pacman -Dk >/dev/null 2>&1; then ok "$(loc "package database is consistent")"; else fail "$(loc "the package database is damaged")"; fi
  if [ -z "$(ls -A "$M/etc/pacman.d/gnupg" 2>/dev/null)" ]; then
    inchroot bash -c 'pacman-key --init && pacman-key --populate' >>"$LOG" 2>&1 && ok "$(loc "keyring recreated")" || fail "$(loc "keyring could not be recreated")"
  fi
  if [ -x "$M/usr/local/bin/sunshine-repo" ]; then inchroot /usr/local/bin/sunshine-repo ensure --quiet >>"$LOG" 2>&1 || fail "$(loc "sunshine-repo ensure failed")"; fi
}
step_core() {
  sec "Core packages"
  local missing=() p
  for p in base linux-firmware mkinitcpio grub sudo networkmanager sddm pipewire pacman; do inchroot pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p"); done
  inchroot pacman -Qq 2>/dev/null | grep -qE '^linux(-lts|-zen|-hardened|-rt|-rt-lts|-cachyos[a-z-]*)?$' || missing+=(linux)
  if [ ${#missing[@]} -eq 0 ]; then ok "$(loc "core packages are installed")"; return; fi
  echo "$(loc "missing"): ${missing[*]}"
  if inchroot pacman -S --noconfirm --needed "${missing[@]}" >>"$LOG" 2>&1; then ok "$(loc "reinstalled"): ${missing[*]}"; else fail "$(loc "could not reinstall (no network? see") $LOG)"; fi
}
step_kernel() {
  sec "Kernel and initramfs"
  local k base any=0
  for k in "$M"/usr/lib/modules/*/; do
    [ -d "$k" ] || continue; any=1
    base=linux; [ -f "$k/pkgbase" ] && base=$(cat "$k/pkgbase")
    if [ ! -f "$M/boot/vmlinuz-$base" ]; then
      if [ -f "$k/vmlinuz" ] && cp --sparse=never "$k/vmlinuz" "$M/boot/vmlinuz-$base" 2>>"$LOG" && chmod 644 "$M/boot/vmlinuz-$base"; then ok "vmlinuz-$base $(loc "restored")"; else fail "vmlinuz-$base $(loc "could not be restored")"; fi
    fi
  done
  if [ $any = 0 ]; then
    echo "$(loc "No kernel is installed in that system: installing linux")"
    if inchroot pacman -S --noconfirm --needed linux linux-firmware >>"$LOG" 2>&1; then ok "$(loc "kernel installed")"; else fail "$(loc "the kernel could not be installed (no network?)")"; return; fi
  fi
  bf=$(df --output=avail -BM "$M/boot" 2>/dev/null | tail -1 | tr -dc 0-9)
  if [ "${bf:-999}" -lt 60 ]; then fail "$(loc "/boot has only") ${bf} MB $(loc "free: an initramfs would be written half-way. Remove an old kernel (sunshine-kernel remove) or enlarge /boot first.")"; return; fi
  if inchroot mkinitcpio -P >>"$LOG" 2>&1; then ok "$(loc "initramfs rebuilt for every kernel")"; else fail "$(loc "mkinitcpio failed; see") $LOG"; tail -4 "$LOG"; fi
}
step_fstab() {
  sec "fstab"
  local n=0 src mp id opts
  while read -r src mp opts; do
    case "$opts" in *nofail*|*noauto*|*x-systemd.automount*) continue;; esac
    case "$src" in
      UUID=*) id=${src#UUID=}; blkid -U "$id" >/dev/null 2>&1 || { bad "fstab: $mp: $(loc "missing UUID") $id"; n=$((n+1)); };;
      LABEL=*) blkid -L "${src#LABEL=}" >/dev/null 2>&1 || { bad "fstab: $mp: $(loc "missing label") ${src#LABEL=}"; n=$((n+1)); };;
    esac
  done < <(awk '$1!~/^#/ && NF>=4 && $2!="none" && $3!="swap" {print $1, $2, $4}' "$M/etc/fstab")
  # the EFI partition is identified safely (FAT32 with the ESP flag), so a wrong UUID there can be corrected; other entries are never guessed
  if [ -d /sys/firmware/efi ] && [ $n -gt 0 ]; then
    local esp old new
    esp=$(lsblk -rpno NAME,PARTTYPE,FSTYPE | awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" && $3=="vfat"{print $1; exit}')
    old=$(awk '$2=="/boot/efi" || $2=="/efi" || $2=="/boot" {print $1}' "$M/etc/fstab" | grep '^UUID=' | head -1)
    if [ -n "$esp" ] && [ -n "$old" ] && ! blkid -U "${old#UUID=}" >/dev/null 2>&1; then
      new=$(blkid -s UUID -o value "$esp")
      if [ -n "$new" ]; then cp "$M/etc/fstab" "$M/etc/fstab.sunshine-old" && sed -i "s/${old#UUID=}/$new/" "$M/etc/fstab" && ok "$(loc "EFI partition UUID in fstab corrected to") $new ($(loc "old file kept as fstab.sunshine-old"))" && n=$((n-1)); fi
    fi
  fi
  [ $n = 0 ] && ok "$(loc "every fstab entry points to an existing partition")" || fail "$n $(loc "fstab entries do not match the partitions: fix with: sunshine-rescue chroot, then nano /etc/fstab")"
}
efi_dir() { local t; for t in /boot/efi /boot /efi; do [ "$(findmnt -rno FSTYPE "$M$t" 2>/dev/null | head -1)" = vfat ] && { echo "$t"; return; }; done; }
step_boot() {
  sec "Boot loader"
  local efi disk src
  if [ -d /sys/firmware/efi ]; then
    efi=$(efi_dir)
    [ -n "$efi" ] || { fail "$(loc "the EFI partition of the installed system is not mounted (is it in its fstab?)")"; return; }
    inchroot grub-install --target=x86_64-efi --efi-directory="$efi" --bootloader-id=SunshineOS --recheck >"$LOG.grub" 2>&1 || bad "$(loc "grub-install (NVRAM) failed, trying the fallback path; see") $LOG.grub"
    if inchroot grub-install --target=x86_64-efi --efi-directory="$efi" --removable --recheck >>"$LOG.grub" 2>&1; then ok "GRUB (UEFI) $(loc "installed on") $efi"; else fail "grub-install: $(tail -2 "$LOG.grub" | tr '\n' ' ')"; return; fi
  else
    src=$(findmnt -no SOURCE -T "$M/boot" 2>/dev/null | sed 's/\[.*//' | head -1)
    [ -n "$src" ] || src=$(findmnt -no SOURCE "$M" | sed 's/\[.*//' | head -1)
    disk=$(lsblk -rno PKNAME "$src" 2>/dev/null | head -1)
    while [ -n "$disk" ] && [ "$(lsblk -rno TYPE "/dev/$disk" 2>/dev/null | head -1)" != disk ]; do disk=$(lsblk -rno PKNAME "/dev/$disk" 2>/dev/null | head -1); done
    [ -n "$disk" ] || { fail "$(loc "cannot find the boot disk")"; return; }
    if inchroot grub-install --target=i386-pc --recheck "/dev/$disk" >"$LOG.grub" 2>&1; then ok "GRUB (BIOS) $(loc "installed on") /dev/$disk"; else fail "grub-install: $(tail -2 "$LOG.grub" | tr '\n' ' ')"; return; fi
  fi
  if inchroot grub-mkconfig -o /boot/grub/grub.cfg >"$LOG.grub" 2>&1 && grep -q menuentry "$M/boot/grub/grub.cfg" && { ! command -v grub-script-check >/dev/null || grub-script-check "$M/boot/grub/grub.cfg" >>"$LOG.grub" 2>&1; }; then ok "$(loc "boot menu rebuilt and checked")"; else fail "grub-mkconfig: $(tail -2 "$LOG.grub" | tr '\n' ' ')"; fi
}
step_doctor() {
  sec "Sunshine doctor"
  # the live medium's doctor is the newest one: run that inside the installed system (its own copy may be old or the thing that is broken)
  if [ -x /usr/local/bin/sunshine-doctor ]; then
    install -m755 /usr/local/bin/sunshine-doctor "$M/root/.sunshine-doctor-rescue"
    inchroot /root/.sunshine-doctor-rescue --fix 2>&1 | sed 's/^/  /' | tail -60
    rm -f "$M/root/.sunshine-doctor-rescue"
  elif [ -x "$M/usr/local/bin/sunshine-doctor" ] || [ -x "$M/usr/bin/sunshine-doctor" ]; then inchroot sunshine-doctor --fix 2>&1 | sed 's/^/  /' | tail -40
  else echo "$(loc "sunshine-doctor is not installed in that system")"; fi
}
do_fsck() {
  local line=$1 dev fs rc
  dev=$(printf '%s' "$line" | cut -f1); dev=${dev%%:*}; fs=$(printf '%s' "$line" | cut -f2)
  is_mounted && do_umount
  if findmnt -rno SOURCE 2>/dev/null | grep -Fq "$dev"; then die "$(loc "file system is still mounted; unmount it before checking") $dev"; fi
  sec "File system check ($fs)"
  case "$fs" in
    ext2|ext3|ext4)
      # first a read-only look; changes to the disk only when errors were found AND (a person confirmed, or SUNSHINE_RESCUE_YES=1 for scripts)
      e2fsck -fn "$dev" >>"$LOG" 2>&1; rc=$?
      if [ $rc -eq 0 ]; then ok "$(loc "file system is clean")"
      else
        echo "$(loc "The file system has errors.")"
        a=n; if [ "${SUNSHINE_RESCUE_YES:-0}" = 1 ]; then a=y; elif [ -t 0 ]; then read -rp "$(loc "Repair them now? (changes the disk) [y/N] ")" a </dev/tty; fi
        if [ "${a,,}" = y ]; then e2fsck -fy "$dev" >>"$LOG" 2>&1; rc=$?; [ $rc -le 1 ] && ok "$(loc "file system repaired")" || fail "e2fsck: exit $rc (see $LOG)"
        else fail "$(loc "file system errors left unrepaired (run again and confirm, or SUNSHINE_RESCUE_YES=1)")"; fi
      fi;;
    btrfs) btrfs check --readonly "$dev" >>"$LOG" 2>&1 && ok "$(loc "btrfs is consistent")" || fail "$(loc "btrfs reports problems; see") $LOG ($(loc "btrfs check --repair is a last resort: copy your data first"))";;
    xfs) xfs_repair "$dev" >>"$LOG" 2>&1 && ok "xfs $(loc "is consistent")" || fail "xfs_repair: see $LOG";;
    f2fs) fsck.f2fs -f "$dev" >>"$LOG" 2>&1 && ok "f2fs $(loc "is consistent")" || fail "fsck.f2fs: see $LOG";;
    *) echo "$(loc "no checker for") $fs";;
  esac
}
do_passwd() {
  local user=$1
  inchroot id "$user" >/dev/null 2>&1 || { fail "$user: $(loc "no such user in the installed system")"; return 1; }
  if [ -n "${SUNSHINE_NEW_PASS:-}" ]; then printf '%s:%s\n' "$user" "$SUNSHINE_NEW_PASS" | inchroot chpasswd && ok "$(loc "password changed for") $user" || { fail "chpasswd failed"; return 1; }
  else inchroot passwd "$user" || { fail "passwd failed"; return 1; }; fi
  inchroot faillock --user "$user" --reset >/dev/null 2>&1; true
}

need arch-chroot; need lsblk
cmd=${1:-menu}; shift 2>/dev/null || true
case "$cmd" in
  list) l=$(scan); [ -n "$l" ] && printf '%s\n' "$l" | awk -F'\t' '{printf "%-24s %-6s %s\n",$1,$2,$3}' || echo "$(loc "No installed Linux system was found.")" ;;
  umount) do_umount && ok "$(loc "unmounted")" ;;
  mount) line=$(pick "${1:-}") || exit 1; do_mount "$line" ;;
  chroot) line=$(pick "${1:-}") || exit 1; do_mount "$line"; echo "$(loc "You are inside the installed system. Type exit to leave.")"; inchroot /bin/bash; do_umount ;;
  run) dev=; [ "${1:-}" != -- ] && [ -n "${1:-}" ] && { dev=$1; shift; }; [ "${1:-}" = -- ] && shift; line=$(pick "$dev") || exit 1; do_mount "$line"; inchroot "$@"; rc=$?; do_umount; exit $rc ;;
  fsck) line=$(pick "${1:-}") || exit 1; do_fsck "$line"; [ $fails = 0 ] ;;
  passwd) user=${1:?user name}; line=$(pick "${2:-}") || exit 1; do_mount "$line"; do_passwd "$user" || { do_umount; exit 1; }; do_umount ;;
  initramfs) line=$(pick "${1:-}") || exit 1; do_mount "$line"; step_kernel; do_umount; [ $fails = 0 ] ;;
  bootloader) line=$(pick "${1:-}") || exit 1; do_mount "$line"; step_boot; do_umount; [ $fails = 0 ] ;;
  repair)
    line=$(pick "${1:-}") || exit 1
    # a failing drive must be copied, not "repaired": stop before touching anything unless told otherwise
    if command -v smartctl >/dev/null; then
      d=$(printf '%s' "$line" | cut -f1); d=${d%%:*}
      pk=$(lsblk -rno PKNAME "$d" 2>/dev/null | head -1); case "$d" in /dev/mapper/sunshine-luks-*) pk=$(lsblk -rno PKNAME "/dev/${d##*sunshine-luks-}" 2>/dev/null | head -1);; esac
      if [ -n "$pk" ] && smartctl -H "/dev/$pk" 2>/dev/null | grep -qiE 'test result: *FAILED|Health Status: *(FAIL|BAD)'; then
        bad "$(loc "The disk") /dev/$pk $(loc "reports a hardware failure (SMART). Repairs can make a dying disk worse: copy your files first (the live session has ddrescue and rsync). To repair anyway: SUNSHINE_RESCUE_FORCE=1 sunshine-rescue repair")"
        [ "${SUNSHINE_RESCUE_FORCE:-0}" = 1 ] || exit 1
      fi
    fi
    [ "${SUNSHINE_RESCUE_FSCK:-1}" = 1 ] && do_fsck "$line"
    do_mount "$line"
    step_pacman; step_core; step_kernel; step_fstab; step_boot; step_doctor
    mkdir -p "$M/var/log/sunshine" && cp "$LOG" "$M/var/log/sunshine/rescue-$(date +%Y%m%d-%H%M%S).log" 2>/dev/null && echo "$(loc "log kept on the repaired system"): /var/log/sunshine/rescue-*.log"
    sync; do_umount
    echo
    if [ $fails = 0 ]; then printf '%s\n' "${G}$(loc "Repair finished. Restart and remove the live medium.")${N}"; exit 0
    else bad "$fails $(loc "step(s) failed; the log is") $LOG"; exit 1; fi ;;
  menu)
    [ -t 0 ] || { sed -n 2,19p "$0"; exit 0; }
    echo "${Y}${B}Sunshine OS rescue${N}"; echo
    list=$(scan); [ -n "$list" ] || die "$(loc "No installed Linux system was found.")"
    printf '%s\n' "$list" | awk -F'\t' '{printf "  found: %-24s %-6s %s\n",$1,$2,$3}'
    echo; echo "  1) $(loc "Repair everything (recommended)")"; echo "  2) $(loc "Reinstall the boot loader")"; echo "  3) $(loc "Rebuild the initramfs")"
    echo "  4) $(loc "Reset a user password")"; echo "  5) $(loc "Check the file system")"; echo "  6) $(loc "Open a shell inside the installed system")"; echo "  q) $(loc "Quit")"
    read -rp "> " c </dev/tty
    case "$c" in 1) exec "$0" repair;; 2) exec "$0" bootloader;; 3) exec "$0" initramfs;; 5) exec "$0" fsck;; 6) exec "$0" chroot;;
      4) read -rp "$(loc "User name: ")" u </dev/tty; exec "$0" passwd "$u";; *) exit 0;; esac ;;
  *) sed -n 2,19p "$0"; exit 2 ;;
esac
