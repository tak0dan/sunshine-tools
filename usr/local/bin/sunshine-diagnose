#!/usr/bin/env bash
# System diagnosis. Writes ~/Sunshine-Diagnostics/diagnosis-<date>.log and keeps the newest 20.
# Runs 10 minutes after each graphical login (user timer) and after every update through the Sunshine tools.
# usage: sunshine-diagnose [--after-update] [--print]
DIR=${SUNSHINE_DIAG_DIR:-$HOME/Sunshine-Diagnostics}; mkdir -p "$DIR"
LOG=$DIR/diagnosis-$(date +%Y-%m-%d_%H%M%S)${1:+${1/--/-}}.log
{
  sec() { printf '\n=== %s ===\n' "$*"; }
  echo "Sunshine OS diagnosis, $(date)"; echo "Kernel: $(uname -r)   Uptime: $(uptime -p)"
  sec "Performance"; echo "Load: $(cut -d' ' -f1-3 /proc/loadavg)"; free -h | sed -n 1,2p; ps -eo pid,comm,%cpu,%mem --sort=-%cpu | head -6
  sec "Temperatures"; if command -v sensors >/dev/null; then sensors 2>/dev/null | grep -E "°C" | head -12; else for z in /sys/class/thermal/thermal_zone*/temp; do [ -r "$z" ] && echo "$(basename "$(dirname "$z")"): $(( $(cat "$z") / 1000 )) °C"; done; fi
  sec "Disk space"; df -hT -x tmpfs -x devtmpfs -x efivarfs 2>/dev/null; echo; df -i / | tail -1
  sec "File system sanity"; findmnt -no FSTYPE,OPTIONS / ; dmesg 2>/dev/null | grep -i -E "ext4-fs error|btrfs.*error|xfs.*corrupt|i/o error" | tail -5 || true
  if [ "$(findmnt -no FSTYPE /)" = btrfs ]; then command -v btrfs >/dev/null && btrfs device stats / 2>/dev/null | grep -v " 0$" || echo "btrfs device stats: no errors"; fi
  sec "Packages"; echo "Installed: $(pacman -Q | wc -l)   Explicit: $(pacman -Qe | wc -l)   Foreign (AUR): $(pacman -Qm | wc -l)"
  command -v checkupdates >/dev/null && echo "Pending updates: $(checkupdates 2>/dev/null | wc -l)"
  sec "Package integrity"; pacman -Dk 2>&1 | tail -5; echo "File check (changed or missing files, first 15):"; pacman -Qkq 2>/dev/null | head -15
  sec "Conflicts and orphans"; echo "Orphans: $(pacman -Qdtq 2>/dev/null | wc -l)"; pacman -Qdtq 2>/dev/null | head -10; echo ".pacnew/.pacsave files:"; find /etc -name '*.pacnew' -o -name '*.pacsave' 2>/dev/null | head -10
  sec "Services and daemons"; systemctl --failed --no-legend 2>/dev/null; systemctl --user --failed --no-legend 2>/dev/null; echo "Failed units above (none listed = none failed)"
  sec "Boot (initramfs / dracut)"; ls -l /boot/initramfs-*.img 2>/dev/null | awk '{print $5, $9}'; command -v lsinitcpio >/dev/null && for i in /boot/initramfs-linux*.img; do [ -f "$i" ] && { lsinitcpio "$i" >/dev/null 2>&1 && echo "$i: readable" || echo "$i: PROBLEM reading it"; }; done
  [ -x /usr/local/bin/sunshine-declare ] && { sec "Declarative setup (Sirius)"; sunshine-declare status 2>&1 | head -12; command -v nix >/dev/null && { echo "nix: $(nix --version)"; systemctl is-active nix-daemon.socket; }; }
  sec "Snapshots"; command -v sunshine-snapshot >/dev/null && sunshine-snapshot status 2>&1 | head -8
  sec "Journal: errors this boot"; journalctl -p 3 -b --no-pager 2>/dev/null | tail -12
} > "$LOG" 2>&1
ls -1t "$DIR"/diagnosis-*.log 2>/dev/null | tail -n +21 | while read -r f; do rm -f "$f"; done
[ "${2:-$1}" = --print ] && cat "$LOG" || echo "$LOG"
